{
  "manifest_version": 3,
  "name": "FINALEXT",
  "version": "6.2",
  "description": "Injects w4p.js into PokerBet poker tables - MAIN world, direct fetch + auto-login",
  "permissions": [],
  "host_permissions": [
    "https://potlimitomaha.xyz/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["credentials.json"],
      "matches": ["*://*.pokerbet.co.za/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.pokerbet.co.za/*"
      ],
      "js": ["autologin.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.pokerbet.co.za/*",
        "*://*.goldrushnation.com/*",
        "*://*.skillgames-bc.com/*",
        "*://*.skillgames.com/*",
        "*://*.betconstruct.com/*"
      ],
      "js": ["w4p.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.pokerbet.co.za/*",
        "*://*.goldrushnation.com/*",
        "*://*.skillgames-bc.com/*",
        "*://*.skillgames.com/*",
        "*://*.betconstruct.com/*"
      ],
      "js": ["strip_images.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
